---
import { nav, site, telHref } from '../data/site';

const phone = site.phone.trim();
const email = site.email.trim();
---

<footer class="border-t border-line bg-[#070707]">
  <div class="frame !pt-16 !pb-8 sm:!pt-20">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <p class="font-display text-lg tracking-[.06em] text-steel">{site.shortName}</p>
        <p class="mt-4 max-w-[16rem] text-sm leading-relaxed text-balance text-muted">{site.tagline}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="flex flex-col gap-3">
          {nav.map((item) => (
            <li><a class="nav-link" href={item.href}>{item.label}</a></li>
          ))}
          <li><a class="nav-link" href="/quote/">Request a quote</a></li>
        </ul>
      </nav>
      <div class="text-sm leading-relaxed text-muted">
        <p class="kicker">South Georgia</p>
        <p class="mt-4">Metal privacy fences, gates, planks and parts.</p>
        {phone && <p class="mt-4"><a class="link-quiet text-lg font-semibold" href={telHref(phone)}>{phone}</a></p>}
        {email && <p class="mt-2"><a class="link-quiet" href={`mailto:${email}`}>{email}</a></p>}
      </div>
    </div>
    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-muted">
      <p>{site.name} · {site.region}</p>
      <a class="link-quiet" href="/privacy/">Privacy</a>
    </div>
  </div>
</footer>
