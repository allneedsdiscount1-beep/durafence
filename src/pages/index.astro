---
import Base from '../layouts/Base.astro';
import BrandLockup from '../components/BrandLockup.astro';
import CatalogImage from '../components/CatalogImage.astro';
import CatalogCredit from '../components/CatalogCredit.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { site } from '../data/site';
import { featured, trades } from '../data/services';
import { steps } from '../data/process';
---

<Base
  title="Dura Fence Metal | Privacy Fences, Gates & Parts in South Georgia"
  description="Metal privacy fences, pedestrian and driveway gates, planks and parts in South Georgia. Explore the catalog and calculate a Standard or Premium estimate."
>
  <section class="theme-dark stage hero-grid relative overflow-x-hidden px-5 pt-[calc(var(--header-h)+3rem)] sm:px-8 sm:pt-[calc(var(--header-h)+4rem)]">
    <div class="relative mx-auto flex max-w-[1120px] flex-col items-center text-center">
      <BrandLockup />
      <p class="mt-10 max-w-2xl text-lg text-balance text-muted sm:text-xl">Metal privacy fences, matching gates and fence parts in South Georgia. Compare your options and build an estimate for materials or installation.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        <a class="btn-steel" href="/estimate/">Build your estimate <span aria-hidden="true">→</span></a>
        <a class="btn-ghost" href="/quote/">Request a quote</a>
      </div>

      <nav class="mt-16 w-full sm:mt-20" aria-label="Product catalog">
        <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-t-[14px] border border-b-0 border-white/10 bg-white/10 lg:grid-cols-4">
          {trades.map((service) => (
            <li>
              <a href={service.href} class="trade-link">
                <ServiceIcon name={service.icon} class="h-7 w-7 shrink-0 text-gold" />
                <span class="flex flex-col items-start text-left">
                  <span class="text-[.7rem] font-medium tracking-[.14em] text-[#a3a5a9] uppercase">{service.name[0]}</span>
                  <span class="text-base font-semibold tracking-[.04em] sm:text-[1.05rem]">{service.name[1]}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="metal-heading">
    <div class="frame">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div class="max-w-2xl">
          <p class="kicker">The complete fence system</p>
          <h2 id="metal-heading" class="section-title mt-4">Privacy, access & every part</h2>
          <p class="lede">Metal privacy fencing, matching gates and the components that connect them. Explore the styles and finishes, then build your estimate with Dura Fence Metal.</p>
        </div>
        <div class="flex flex-wrap items-center gap-6"><a class="link-quiet" href="/services/#finishes">View finishes</a><a class="btn-steel" href="/estimate/">Build your estimate</a></div>
      </div>
      <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((item, index) => (
          <li class="flex">
            <a class="product-card" href={item.href}>
              <CatalogImage image={item.image} alt={item.alt} />
              <div class="flex flex-1 flex-col gap-3 px-3 pt-6 pb-4">
                <p class="font-display text-[.7rem] tracking-[.2em] text-subtle">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="text-2xl font-semibold tracking-tight text-heading">{item.name}</h3>
                <p class="flex-1 text-muted">{item.spec}</p>
                <span class="more-link mt-2">Explore {item.name.toLowerCase()} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <CatalogCredit />
    </div>
  </section>

  <section class="border-t border-line bg-surface-2" aria-labelledby="process-heading">
    <div class="frame">
      <p class="kicker">From selection to installation</p>
      <h2 id="process-heading" class="section-title mt-4">Plan your project</h2>
      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {steps.map((step, index) => (
          <li class="flex flex-col gap-4">
            <div class="flex items-center gap-4">
              <span class:list={['step-badge', { 'step-badge-final': index === steps.length - 1 }]}>{step.n}</span>
              {index < steps.length - 1 && <span class="gold-rule h-px flex-1 opacity-50" aria-hidden="true"></span>}
            </div>
            <h3 class="mt-2 text-xl font-semibold tracking-tight text-heading">{step.title}</h3>
            <p class="text-muted">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="area-heading">
    <div class="frame grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <p class="kicker">Service area</p>
        <h2 id="area-heading" class="font-display mt-5 text-[clamp(1.6rem,3.4vw,2.5rem)] leading-tight tracking-[.08em] text-heading uppercase">{site.region}</h2>
        <span class="gold-rule mt-6 block h-px w-28" aria-hidden="true"></span>
        <p class="lede">Fence materials and installation for properties across South Georgia. Contact us to confirm service at your location.</p>
        <p class="mt-7"><a class="more-link" href="/service-area/">Service area <span aria-hidden="true">→</span></a></p>
      </div>
      <ul class="grid grid-cols-2 gap-2.5 sm:grid-cols-3" aria-label="Towns">
        {site.cities.map((city) => (
          <li class="city-chip">
            <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 shrink-0 text-gold" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M8 15s5-4.6 5-8.5A5 5 0 0 0 3 6.5C3 10.4 8 15 8 15Z"></path><circle cx="8" cy="6.5" r="1.8"></circle></svg>
            {city}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="px-5 pb-20 sm:px-8 sm:pb-28" aria-labelledby="close-heading">
    <div class="theme-dark stage cta-panel mx-auto max-w-[1120px] text-center">
      <p class="metal-title text-[clamp(2rem,6vw,3.4rem)] leading-none font-normal tracking-[.04em] uppercase">{site.shortName}</p>
      <div class="relative mx-auto mt-4 flex max-w-md items-center justify-center gap-4">
        <span class="gold-rule h-px min-w-0 flex-1" aria-hidden="true"></span>
        <p class="metal-subtitle pl-[.7em] text-2xl leading-none font-semibold tracking-[.7em] uppercase">{site.metal}</p>
        <span class="gold-rule gold-rule-right h-px min-w-0 flex-1" aria-hidden="true"></span>
      </div>
      <h2 id="close-heading" class="section-title mx-auto mt-10 max-w-[16ch]">Your fence. Your finish. Your estimate.</h2>
      <p class="lede mx-auto">Start with the length of your fence. Compare packages, add gates and choose materials only or installation. For individual parts or a custom configuration, request a quote.</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3.5"><a class="btn-steel" href="/estimate/">Calculate your price <span aria-hidden="true">→</span></a><a class="btn-ghost" href="/quote/">Request a quote</a></div>
    </div>
  </section>
</Base>
