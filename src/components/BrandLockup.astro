---
import Monogram from './Monogram.astro';
import { site } from '../data/site';
---

<div class="relative z-10 mx-auto flex w-full max-w-[640px] flex-col items-center text-center">
  <Monogram idPrefix="hero" class="logo h-auto w-[min(100%,520px)]" />

  <h1 class="metal-title mt-2 text-[clamp(2.1rem,9vw,4.4rem)] leading-none font-normal tracking-[.01em] uppercase whitespace-nowrap">
    {site.shortName}
  </h1>

  <div class="mt-3 flex w-[min(100%,560px)] items-center justify-center gap-5" aria-label={site.metal}>
    <span class="gold-rule h-px min-w-0 flex-1" aria-hidden="true"></span>
    <p class="metal-subtitle pl-[.9em] text-[clamp(1.5rem,5.8vw,2.15rem)] leading-none font-semibold tracking-[.9em] uppercase">{site.metal}</p>
    <span class="gold-rule gold-rule-right h-px min-w-0 flex-1" aria-hidden="true"></span>
  </div>

  <p class="mt-5 text-[clamp(.6rem,1.6vw,.75rem)] leading-relaxed font-light tracking-[.36em] text-[#c6c7ca] uppercase sm:tracking-[.5em]">
    {site.tagline}
  </p>
</div>
